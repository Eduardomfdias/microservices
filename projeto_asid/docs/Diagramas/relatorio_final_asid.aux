\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Diagrama de dependências entre microserviços. Verde: \texttt  {frontend} (depende de 8 serviços, mais vulnerável a falhas em cascata). Vermelho: \texttt  {checkoutservice} (orquestrador de 6 serviços em série). Laranja: \texttt  {redis-cart} (único componente \textit  {stateful}). Folhas (verde claro) — \texttt  {paymentservice}, \texttt  {emailservice}, \texttt  {adservice}, \texttt  {shippingservice} — sem dependências externas. O \texttt  {productcatalogservice} e o \texttt  {redis-cart} são os candidatos principais a pontos de saturação: o primeiro por fan-out ×6 em W1; o segundo por contenção de estado partilhado em W2/W3.}}{23}{figure.caption.29}\protected@file@percent }
\newlabel{fig:dependencias}{{7}{23}{Diagrama de dependências entre microserviços. Verde: \texttt {frontend} (depende de 8 serviços, mais vulnerável a falhas em cascata). Vermelho: \texttt {checkoutservice} (orquestrador de 6 serviços em série). Laranja: \texttt {redis-cart} (único componente \textit {stateful}). Folhas (verde claro) — \texttt {paymentservice}, \texttt {emailservice}, \texttt {adservice}, \texttt {shippingservice} — sem dependências externas. O \texttt {productcatalogservice} e o \texttt {redis-cart} são os candidatos principais a pontos de saturação: o primeiro por fan-out ×6 em W1; o segundo por contenção de estado partilhado em W2/W3}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces W1 — Browse Product (\texttt  {GET /product/\{id\}}). O \texttt  {frontend} realiza 6 chamadas gRPC sequenciais ao \texttt  {productcatalogservice} por pedido, mais chamadas ao \texttt  {currencyservice}, \texttt  {recommendationservice}, \texttt  {adservice} e \texttt  {cartservice}. Operação mais frequente no modelo de carga (peso 10).}}{24}{figure.caption.30}\protected@file@percent }
\newlabel{fig:seq-w1}{{8}{24}{W1 — Browse Product (\texttt {GET /product/\{id\}}). O \texttt {frontend} realiza 6 chamadas gRPC sequenciais ao \texttt {productcatalogservice} por pedido, mais chamadas ao \texttt {currencyservice}, \texttt {recommendationservice}, \texttt {adservice} e \texttt {cartservice}. Operação mais frequente no modelo de carga (peso 10)}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces W2 — Add to Cart (\texttt  {POST /cart}). O \texttt  {frontend} valida o produto via \texttt  {productcatalogservice} e persiste no \texttt  {redis-cart} através do \texttt  {cartservice} com uma operação HSET bloqueante. Pré-requisito funcional do checkout.}}{25}{figure.caption.31}\protected@file@percent }
\newlabel{fig:seq-w2}{{9}{25}{W2 — Add to Cart (\texttt {POST /cart}). O \texttt {frontend} valida o produto via \texttt {productcatalogservice} e persiste no \texttt {redis-cart} através do \texttt {cartservice} com uma operação HSET bloqueante. Pré-requisito funcional do checkout}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces W3 — Checkout (\texttt  {POST /cart/checkout}). O \texttt  {checkoutservice} orquestra 6 serviços em sequência: GetCart, GetProduct, Convert, GetQuote/ShipOrder, Charge e SendConfirmation, seguido de EmptyCart. A latência total é a soma de todas as chamadas individuais — sem paralelismo.}}{26}{figure.caption.32}\protected@file@percent }
\newlabel{fig:seq-w3}{{10}{26}{W3 — Checkout (\texttt {POST /cart/checkout}). O \texttt {checkoutservice} orquestra 6 serviços em sequência: GetCart, GetProduct, Convert, GetQuote/ShipOrder, Charge e SendConfirmation, seguido de EmptyCart. A latência total é a soma de todas as chamadas individuais — sem paralelismo}{figure.caption.32}{}}
